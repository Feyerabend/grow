# Do two trees have the same leaves, in the same order, whatever
# their shapes? The walk is recursive, and hands its leaves over
# one at a time, from wherever in the recursion it has got to.
#
# A tree is a function, as a pair is in data.lam: given what to do
# with a leaf and with a node, it does the one that applies.

let leaf x = fun l n -> l x in
let node a b = fun l n -> n a b in

let rec walk t =
  t (fun x -> print x; yield x)
    (fun a b -> walk a; walk b) in

let leaves t = coroutine (fun ignored -> walk t) in

let rec same a b =
  let x = resume a 0 in
  let y = resume b 0 in
  if finished a then finished b
  else if finished b then 0
  else if x = y then same a b
  else 0 in

let samefringe s t = same (leaves s) (leaves t) in

let one = node (node (leaf 1) (leaf 2))
               (node (leaf 3) (leaf 4)) in
let two = node (leaf 1) (node (leaf 2)
                              (node (leaf 3) (leaf 4))) in
let three = node (leaf 1) (node (leaf 9)
                                (node (leaf 3) (leaf 4))) in
let four = node (leaf 1) (leaf 2) in

print (samefringe one two);     # 1 1 2 2 3 3 4 4, then 1
print (samefringe one three);   # 1 1 2 9, then 0: it stops there
print (samefringe one four)     # 1 1 2 2 3, then 0
