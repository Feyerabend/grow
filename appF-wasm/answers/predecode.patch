+static uint32_t imm_u32(const uint8_t *b, uint32_t *pc);
+static int64_t imm_s64(const uint8_t *b, uint32_t *pc);
 
+/* Translate a validated body into Instrs, once: each instruction's
+ * immediates read, and each block's end and each if's else found, as
+ * indices of Instrs. The bytes were checked by decoding and validation. */
+enum { NO_ELSE = 0xFFFFFFFFu };
+
+static void translate(Code *code)
+{
+    const uint8_t *body = code->body;
+    uint32_t len = (uint32_t)code->len, n = 0, ntargets = 0;
+    uint32_t *at = grow(NULL, len + 1, sizeof(uint32_t));     /* byte -> Instr */
+    Instr *ins = grow(NULL, len + 1, sizeof(Instr));
+    uint32_t *targets = NULL;
+    for (uint32_t pc = 0; pc < len; n++) {
+        uint32_t start = pc;
+        Instr in = {body[pc++], 0, 0};
+        at[start] = n;
+        switch (in.op) {
+        case 0x02: case 0x03: case 0x04:
+            in.a = start;               /* for now: found below */
+            in.b = body[pc++] != 0x40;
+            break;
+        case 0x0C: case 0x0D: case 0x10:
+        case 0x20: case 0x21: case 0x22: case 0x23: case 0x24:
+            in.a = imm_u32(body, &pc);
+            break;
+        case 0x0E:
+            in.a = imm_u32(body, &pc);
+            in.b = ntargets;
+            targets = grow(targets, ntargets + in.a + 1, sizeof(uint32_t));
+            for (uint32_t k = 0; k <= in.a; k++)
+                targets[ntargets++] = imm_u32(body, &pc);
+            break;
+        case 0x11: in.a = imm_u32(body, &pc); pc++; break;
+        case 0x3F: case 0x40: pc++; break;
+        case 0x41: in.b = (uint32_t)imm_s64(body, &pc); break;
+        case 0x42: in.b = (uint64_t)imm_s64(body, &pc); break;
+        case 0x43: { uint32_t u; memcpy(&u, body + pc, 4); pc += 4; in.b = u; break; }
+        case 0x44: memcpy(&in.b, body + pc, 8); pc += 8; break;
+        default:
+            if (in.op >= 0x28 && in.op <= 0x3E) {
+                imm_u32(body, &pc);     /* the alignment: only a hint */
+                in.a = imm_u32(body, &pc);
+            }
+        }
+        ins[n] = in;
+    }
+    at[len] = n;
+    for (uint32_t k = 0; k < n; k++) {
+        uint32_t start = ins[k].a;
+        if (ins[k].op == 0x03)
+            ins[k].a = k;
+        else if (ins[k].op == 0x02 || ins[k].op == 0x04) {
+            ins[k].a = at[code->ends[start]] + 1;
+            if (ins[k].op == 0x04)
+                ins[k].b |= (uint64_t)(code->elses[start] >= 0 ?
+                                       at[code->elses[start]] + 1 : NO_ELSE) << 32;
+        }
+    }
+    free(at);
+    code->instrs = ins;
+    code->ninstrs = n;
+    code->targets = targets;
+}
