-        return f"(lambda {quote(param)} {expr(body, [param] + scope)})"
+        # The closure keeps only the cells its body uses: their depths
+        # here, innermost first. In the body they come after the
+        # parameter, in the same order.
+        used = free(body) - {param}
+        kept = []
+        for n in scope:
+            if n in used and n not in kept:
+                kept.append(n)
+        depths = " ".join(str(where(n, scope)) for n in kept)
+        return f"(lambda {quote(param)} ({depths}) {expr(body, [param] + kept)})"
     raise TypeError(f"expr: {type(e).__name__}")
 
 
