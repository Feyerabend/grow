+def free(e):
+    """The names an expression uses and does not bind itself."""
+    if isinstance(e, TLit):
+        return set()
+    if isinstance(e, (TVar, TCon)):
+        return {e.name}
+    if isinstance(e, TTupleExpr):
+        return set().union(*(free(x) for x in e.elems))
+    if isinstance(e, TApply):
+        return free(e.fn).union(*(free(a) for a in e.args))
+    if isinstance(e, TBinOp):
+        return free(e.left) | free(e.right)
+    if isinstance(e, TUnaryOp):
+        return free(e.operand)
+    if isinstance(e, TLetExpr):
+        return free(e.value) | (free(e.body) - {e.name})
+    if isinstance(e, TIfExpr):
+        return free(e.cond) | free(e.then_) | free(e.else_)
+    if isinstance(e, TMatchExpr):
+        names = free(e.scrutinee)
+        for p, b in e.arms:
+            bound = []
+            pattern(p, bound)
+            names |= free(b) - set(bound)
+        return names
+    if isinstance(e, TLambda):
+        return free(lambdas(e.params[1:], e.body)) - {e.params[0][0]}
+    raise TypeError(f"free: {type(e).__name__}")
+
+
 def expr(e, scope):
