+/* A new frame for a call of a function whose body is f, inside the frame
+ * next. Its slots start as unit, so that the collector never follows a
+ * stray pointer in one not yet bound. */
+static LkEnv* frame_new(LkEnv* next, const LkExpr* f) {
+    LkEnv* fr = AR(OBJ_ENV, sizeof(LkEnv) + (size_t)f->frame.n * sizeof(LkVal));
+    fr->next  = next;
+    fr->names = f->frame.names;
+    fr->n     = f->frame.n;
+    for (int i = 0; i < fr->n; i++)
+        fr->vals[i] = (LkVal){ .kind = V_UNIT };
+    return fr;
 }
 
